{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "apps/agent_bridge/**/*.ts",
    "services/relay/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "packages/connector_sdk/.example-dist",
    "packages/connector_sdk/.test-dist",
    "packages/connector_sdk/examples/**/*.ts"
  ]
}
