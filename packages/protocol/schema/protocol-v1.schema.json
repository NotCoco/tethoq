{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tethoq.local/schema/protocol-v1.schema.json",
  "title": "Tethoq wire protocol v1",
  "description": "JSON messages exchanged between a remote device and Agent Bridge. Device requests are normally carried inside a signed_action wrapper; pairing.confirm may be sent unsigned.",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" },
    { "$ref": "#/$defs/eventEnvelope" },
    { "$ref": "#/$defs/helloEnvelope" },
    { "$ref": "#/$defs/signedActionMessage" }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "baseProperties": {
      "type": "object",
      "required": ["protocolVersion", "messageId", "hostId", "sentAt", "kind", "type"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "messageId": { "type": "string", "minLength": 1 },
        "hostId": { "type": "string", "minLength": 1 },
        "sentAt": { "type": "string", "format": "date-time" },
        "kind": { "type": "string" },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "requestEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/baseProperties" },
        {
          "type": "object",
          "required": ["requestId", "payload"],
          "properties": {
            "kind": { "const": "request" },
            "requestId": { "type": "string", "minLength": 1 },
            "payload": { "$ref": "#/$defs/jsonObject" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "protocolError": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/jsonObject" }
      },
      "additionalProperties": false
    },
    "responseEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/baseProperties" },
        {
          "type": "object",
          "required": ["requestId", "ok", "payload"],
          "properties": {
            "kind": { "const": "response" },
            "requestId": { "type": "string", "minLength": 1 },
            "ok": { "type": "boolean" },
            "payload": { "$ref": "#/$defs/jsonObject" },
            "error": { "$ref": "#/$defs/protocolError" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "eventEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/baseProperties" },
        {
          "type": "object",
          "required": ["sequence", "payload"],
          "properties": {
            "kind": { "const": "event" },
            "type": { "const": "event.batch" },
            "sequence": { "type": "integer", "minimum": 0 },
            "payload": { "$ref": "#/$defs/jsonObject" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "helloEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/baseProperties" },
        {
          "type": "object",
          "required": ["supportedVersions", "role"],
          "properties": {
            "kind": { "const": "hello" },
            "type": { "const": "protocol.hello" },
            "supportedVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            },
            "role": { "enum": ["host", "device"] },
            "credential": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "signedCredential": {
      "type": "object",
      "required": ["payload", "signature"],
      "properties": {
        "payload": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "signedDeviceAction": {
      "type": "object",
      "required": ["credential", "actionId", "issuedAt", "expiresAt", "action", "signature"],
      "properties": {
        "credential": { "$ref": "#/$defs/signedCredential" },
        "actionId": { "type": "string", "minLength": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "action": { "$ref": "#/$defs/requestEnvelope" },
        "signature": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "signedActionMessage": {
      "type": "object",
      "required": ["kind", "signed"],
      "properties": {
        "kind": { "const": "signed_action" },
        "signed": { "$ref": "#/$defs/signedDeviceAction" }
      },
      "additionalProperties": false
    }
  }
}
