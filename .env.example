# Bridge listener (direct LAN/development transport)
TETHOQ_BRIDGE_HOST=127.0.0.1
TETHOQ_BRIDGE_PORT=8765
TETHOQ_BRIDGE_PATH=/bridge
# TETHOQ_CONFIG_PATH=/absolute/path/to/bridge.json
# TETHOQ_ALLOW_UNSIGNED_LOCAL=0

# Relay. Use wss:// in any non-local deployment and generate a random value
# containing at least 32 characters. Never commit the real token.
# TETHOQ_RELAY_URL=wss://relay.example.com/relay
# TETHOQ_RELAY_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Shared project default used by OpenCode.
# TETHOQ_PROJECT_DIRECTORY=/absolute/path/to/project

# Codex App Server process
TETHOQ_CODEX_COMMAND=codex
TETHOQ_CODEX_ARGS=["app-server","--listen","stdio://"]

# OpenCode server
TETHOQ_OPENCODE_URL=http://127.0.0.1:4096/
# TETHOQ_OPENCODE_COMMAND=opencode
# TETHOQ_OPENCODE_USERNAME=opencode
# TETHOQ_OPENCODE_PASSWORD=host-local-http-password

# Grok Build ACP process
TETHOQ_GROK_COMMAND=grok
TETHOQ_GROK_ARGS=["agent","stdio"]

# Optional overrides for auto-detected public harness CLIs. Their documented
# protocol arguments are used automatically when only the command is present.
# TETHOQ_PI_COMMAND=pi
# TETHOQ_OMP_COMMAND=omp
# TETHOQ_QWEN_COMMAND=qwen
# TETHOQ_GOOSE_COMMAND=goose
# TETHOQ_KIMI_COMMAND=kimi
# TETHOQ_HERMES_COMMAND=hermes
# TETHOQ_CLINE_COMMAND=cline
# TETHOQ_COPILOT_COMMAND=copilot

# Trust-sensitive integrations are disabled by default. These opt-ins permit
# writes to provider-owned tool configuration or reads of undocumented local
# provider state on this host.
# TETHOQ_ALLOW_PROVIDER_CONFIG_MUTATION=1
# TETHOQ_ENABLE_CODEX_LOCAL_STATE=1
# TETHOQ_ENABLE_OPENCODE_LOCAL_STATE=1
# TETHOQ_OPENCODE_DB_PATH=/absolute/path/to/opencode.db

# Optional host-local speech-to-text providers for phone dictation.
# These keys stay in Tethoq Bridge and are independent of harness login state.
# TETHOQ_OPENAI_API_KEY=replace-with-an-openai-api-key
# XAI_API_KEY below can also enable xAI speech-to-text.

# Optional Direct API provider keys. Prefer entering a key through the wallet
# UI when practical; persisted keys are encrypted in host-local state and are
# never returned to a client. Environment keys override the stored value.
# OPENAI_API_KEY=replace-with-an-openai-api-key
# AI_GATEWAY_API_KEY=replace-with-a-vercel-ai-gateway-key
# ZAI_API_KEY=replace-with-a-zai-api-key
# CROFAI_API_KEY=replace-with-a-crofai-api-key
# GOOGLE_API_KEY=replace-with-a-google-ai-studio-key
# GEMINI_API_KEY=replace-with-a-google-ai-studio-key
# OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
# XAI_API_KEY=replace-with-an-xai-api-key
# DEEPSEEK_API_KEY=replace-with-a-deepseek-api-key
# GROQ_API_KEY=replace-with-a-groq-api-key
# MISTRAL_API_KEY=replace-with-a-mistral-api-key
# TOGETHER_API_KEY=replace-with-a-together-api-key
# FIREWORKS_API_KEY=replace-with-a-fireworks-api-key
# CEREBRAS_API_KEY=replace-with-a-cerebras-api-key
# PERPLEXITY_API_KEY=replace-with-a-perplexity-api-key
# A custom endpoint with id `my-service` can instead use:
# TETHOQ_DIRECT_MY_SERVICE_API_KEY=replace-with-that-endpoint-key

# Development/test-only provider
# TETHOQ_ENABLE_FAKE_PROVIDER=1

# Legacy UAR_* names remain accepted as fallbacks for existing installations.
