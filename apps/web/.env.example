# Supabase Project Settings > API. The publishable key is safe for browser use
# because every public table is protected by the RLS policies in /supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical deployed origin used for OAuth and password-reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct HTTPS release-asset URLs. Leave a value blank until that exact artifact
# is published; the corresponding website button will remain disabled.
NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=
NEXT_PUBLIC_BRIDGE_WINDOWS_DOWNLOAD_URL=

# Optional HTTPS links to the published checksum file for each artifact.
NEXT_PUBLIC_DESKTOP_CHECKSUM_URL=
NEXT_PUBLIC_BRIDGE_CHECKSUM_URL=
